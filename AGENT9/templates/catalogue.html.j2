<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Commercial Proposal | {{ specs.part_name }}</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;800&family=Open+Sans:wght@400;600&display=swap');

        :root {
            --primary: #1e293b;
            --secondary: #0ea5e9;
            --accent: #f59e0b;
            --bg-light: #f8fafc;
            --border: #e2e8f0;
            --text-dark: #334155;
            --text-light: #94a3b8;
            --success: #10b981;
        }

        body {
            font-family: 'Open Sans', sans-serif;
            background-color: #eef2f6;
            color: var(--text-dark);
            margin: 0; 
            padding: 0;
            line-height: 1.6;
        }

        .container {
            max-width: 900px;
            margin: 50px auto;
            background: #ffffff;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            border-radius: 12px;
            overflow: hidden;
        }

        .header {
            background-color: var(--primary);
            color: #ffffff;
            padding: 70px 50px;
            text-align: center;
        }

        .header h1 {
            font-family: 'Montserrat', sans-serif;
            margin: 0;
            font-size: 38px;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .header p { margin: 15px 0 0 0; font-size: 16px; color: #cbd5e1; font-weight: 300; }

        .content { padding: 50px; }

        .section { margin-bottom: 55px; }
        
        .section-title {
            font-family: 'Montserrat', sans-serif;
            color: var(--primary);
            font-size: 22px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            border-bottom: 3px solid var(--secondary);
            padding-bottom: 10px;
            margin-bottom: 30px;
            display: inline-block;
        }

        .box {
            background: var(--bg-light);
            border: 1px solid var(--border);
            padding: 30px;
            border-radius: 10px;
        }

        .points-list {
            margin: 0;
            padding-left: 20px;
            list-style-type: none;
        }

        .points-list li {
            position: relative;
            margin-bottom: 12px;
            padding-left: 25px;
            font-size: 15px;
        }

        .points-list li::before {
            content: "→";
            position: absolute;
            left: 0;
            color: var(--secondary);
            font-weight: bold;
        }

        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { padding: 16px 15px; text-align: left; border-bottom: 1px solid var(--border); }
        th { font-weight: 700; color: var(--primary); background: #f1f5f9; width: 40%; }
        
        .tech-table td { font-family: monospace; font-size: 14px; color: #0369a1; }

        .price-hero {
            background-color: var(--primary);
            color: #ffffff;
            padding: 50px;
            border-radius: 10px;
            text-align: center;
            margin-top: 30px;
        }
        
        .price-hero .label { font-size: 14px; text-transform: uppercase; letter-spacing: 3px; color: #94a3b8; margin-bottom: 15px; }
        .price-hero .total { font-family: 'Montserrat', sans-serif; font-size: 52px; font-weight: 800; color: var(--success); }
        .price-hero .note { font-size: 15px; color: #cbd5e1; margin-top: 20px; font-style: italic; }

        .badge {
            display: inline-block;
            background: #e0f2fe;
            color: #0369a1;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            margin-left: 10px;
        }

        .btn {
            display: block;
            width: 100%;
            text-align: center;
            background-color: var(--secondary);
            color: #ffffff;
            text-decoration: none;
            padding: 22px;
            font-size: 20px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 800;
            border-radius: 10px;
            text-transform: uppercase;
            letter-spacing: 2px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 14px rgba(14, 165, 233, 0.4);
        }
        
        .btn:hover { background-color: #0284c7; transform: translateY(-2px); }

        .footer {
            background: var(--bg-light);
            color: var(--text-light);
            text-align: center;
            padding: 40px;
            font-size: 14px;
            border-top: 1px solid var(--border);
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <h1>{{ specs.part_name }}</h1>
        <p>Advanced Commercial Specification & Proposal &bull; Date: {{ generated_date }}</p>
    </div>

    <div class="content">

        <!-- 1. EXECUTIVE HIGHLIGHTS -->
        <div class="section">
            <h2 class="section-title">1. Executive Highlights</h2>
            <div class="box">
                <ul class="points-list">
                    {% for point in client_description_list %}
                    <li>{{ point }}</li>
                    {% endfor %}
                </ul>
                <div style="margin-top: 25px; padding-top: 20px; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <strong style="color: var(--primary);">Investment Grade:</strong> 
                        <span class="badge">Certified {{ specs.material }}</span>
                    </div>
                    <div style="font-size: 18px; font-weight: 700; color: var(--success);">
                        Total Value: ${{ tco.total_purchase_usd | int }}
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. STRATEGIC USE-CASES -->
        <div class="section">
            <h2 class="section-title">2. Strategic Application Context</h2>
            <div class="box">
                <ul class="points-list">
                    {% for point in client_explanation_list %}
                    <li>{{ point }}</li>
                    {% endfor %}
                </ul>
            </div>
        </div>

        <!-- 3. DETAILED PERFORMANCE MATRIX -->
        <div class="section">
            <h2 class="section-title">3. Detailed Performance Matrix</h2>
            <table class="tech-table">
                <thead>
                    <tr>
                        <th>Parameter</th>
                        <th>Certified Specification</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Substrate Material</strong></td>
                        <td>{{ specs.material }}</td>
                        <td>High-durability industrial grade</td>
                    </tr>
                    <tr>
                        <td><strong>Nominal Diameter</strong></td>
                        <td>{{ tech_limits.pressure }} mm</td>
                        <td>Precision bore (+/- {{ tech_limits.tolerance }}mm)</td>
                    </tr>
                    <tr>
                        <td><strong>Operational Pressure</strong></td>
                        <td>{{ tech_limits.pressure }} Bar</td>
                        <td>Maximum structural integrity rating</td>
                    </tr>
                    <tr>
                        <td><strong>Thermal Resilience</strong></td>
                        <td>{{ tech_limits.max_temp }} °C</td>
                        <td>Optimized for high-temp fluid control</td>
                    </tr>
                    <tr>
                        <td><strong>Operational Flow Rate</strong></td>
                        <td>{{ tech_limits.flow_rate }} m³/h</td>
                        <td>High-efficiency throughput design</td>
                    </tr>
                    <tr>
                        <td><strong>Expected Service Life</strong></td>
                        <td>{{ tech_limits.lifespan }} Years</td>
                        <td>Based on standard operational metrics</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- 4. VISUAL & MEDIA ASSETS -->
        <div class="section">
            <h2 class="section-title">4. Visual & Media Assets</h2>
            <div style="display: flex; gap: 20px;">
                {% if video.files_generated %}
                <a href="{{ video.files_generated[0] }}" style="flex: 1; display: block; background: #000; color: #fff; padding: 25px; border-radius: 10px; text-decoration: none; text-align: center; font-weight: 700;">
                    ▶ WATCH PRODUCT VIDEO
                </a>
                {% endif %}
                {% if cad.files_generated %}
                <a href="{{ cad.files_generated[0] }}" style="flex: 1; display: block; border: 2px solid var(--primary); color: var(--primary); padding: 25px; border-radius: 10px; text-decoration: none; text-align: center; font-weight: 700;">
                    📐 VIEW CAD BLUEPRINTS
                </a>
                {% endif %}
            </div>
        </div>

        <!-- 5. PRICING & LOGISTICS -->
        <div class="section">
            <h2 class="section-title">5. Financial & Procurement Terms</h2>
            <table>
                <tr><th>Unit Price (EXW)</th><td>${{ tco.unit_cost_usd | int }}</td></tr>
                <tr><th>Quantity Requested</th><td>{{ tco.quantity_units }} Units</td></tr>
                <tr><th>Assumed Lead Time</th><td>{{ nego.delivery_days }} Days</td></tr>
            </table>
            <div class="price-hero">
                <div class="label">Integrated Order Value</div>
                <div class="total">${{ tco.total_purchase_usd | int }}</div>
                <div class="note">All costs included: Raw materials, manufacturing precision, quality assurance, and global logistics.</div>
            </div>
        </div>

        <!-- 6. PRODUCTION ROADMAP -->
        <div class="section">
            <h2 class="section-title">6. Production Roadmap</h2>
            <div class="box">
                <p><strong>Timeline:</strong> Fulfillment within <strong>{{ nego.delivery_days }} calendar days</strong> from order confirmation.</p>
                <p>Status: <span style="font-weight: 700; color: #0369a1;">Production assigned to a certified industrial manufacturing network.</span></p>
            </div>
        </div>

        <!-- 8. MAINTENANCE & LIFECYCLE -->
        <div class="section">
            <h2 class="section-title">8. Maintenance & Lifecycle</h2>
            <table>
                <thead>
                    <tr><th>Activity</th><th>Schedule Range</th><th>Note</th></tr>
                </thead>
                <tbody>
                    <tr><td>Visual Inspection</td><td>6 months</td><td>Standard verification</td></tr>
                    <tr><td>Operational Service</td><td>12 months</td><td>Performance tuning</td></tr>
                    <tr><td>Full Compliance Audit</td><td>24 months</td><td>Safety recertification</td></tr>
                </tbody>
            </table>
        </div>

        <!-- 9. BUSINESS VALUE -->
        <div class="section">
            <h2 class="section-title">9. Strategic Business Value</h2>
            <div class="box" style="border-left: 5px solid var(--success);">
                <ul class="points-list">
                    {% for point in client_value_list %}
                    <li>{{ point }}</li>
                    {% endfor %}
                </ul>
            </div>
        </div>

        <!-- 10. NEXT ACTION -->
        <div class="section" style="margin-top: 60px;">
            <a href="#" class="btn">Validate Proposal & Initiate Production</a>
        </div>

    </div>
    
    <div class="footer">
        Confidential Document &bull; Smart Engineering Intelligence by INDUSTRIE IA
    </div>
</div>

</body>
</html>
